# Copy to `.env` and fill in values. `.env` is gitignored — never commit secrets.

# WRDS credentials (required for WRDS extraction scripts)
WRDS_USERNAME=
WRDS_PASSWORD=

# Local data paths (defaults shown in README when unset)
CS_LMI_REVELIO_ROOT=
CS_LMI_DUCKDB_PATH=
CS_LMI_PROCESSED_DIR=

# Postgres: CS_LMI_POSTGRES_DSN takes precedence over DATABASE_URL
CS_LMI_POSTGRES_DSN=
DATABASE_URL=

# Optional override for trajectory ML artifact path
ML_MODEL_PATH=

# Comma-separated browser origins for CORS (unset = allow all, no credentials)
CORS_ORIGINS=
