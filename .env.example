# Copy this file to .env and adjust values as needed.
# .env is gitignored — real credentials never get committed.

# --- Postgres container configuration ---
# Used by the `postgres` service in docker-compose.yml to initialize the database.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=cs_lmi

# --- FastAPI -> Postgres connection string ---
# Used by api/dependencies.py (get_postgres_connection) inside the `api` container.
# Host is "postgres" (the docker-compose service name), not "localhost" — containers
# reach each other by service name over the compose network, not via the host's
# loopback address.
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cs_lmi
